          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "let requestBody = {",
                  "    passenger_id: \"1\",",
                  "    address_from: \"123 Main St\",",
                  "    address_to: \"456 Elm St\",",
                  "    tariff: pm.collectionVariables.get(\"TARIFS\").split(\";\")[0],",
                  "    selected_services: pm.collectionVariables.get(\"SERVICES\").split(\";\"),",
                  "    comment: \"Test Request\"",
                  "};",
                  "",
                  "pm.request.body.update(JSON.stringify(requestBody));",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let order_id = parseInt(pm.response.text().split(\":\")[1]);",
                  "pm.collectionVariables.set(\"order_id\", order_id);",
                  "pm.collectionVariables.set(\"last_action\", \"create\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
