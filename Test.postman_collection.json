        {
          "name": "Get Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.test(\"Check for getting order_id\", function(){",
                  "    pm.expect(pm.collectionVariables.get(\"order_id\")).to.not.equal(\"00\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let result = pm.response.text().split(\":\")[1].slice(1);",
                  "",
                  "pm.test(\"Check status\", function(){",
                  "    switch (pm.collectionVariables.get(\"last_action\")) {",
                  "        case \"create\":",
                  "            pm.expect(result).to.equal(\"searching\\n\");",
                  "            break;",
                  "        case \"cancel\":",
                  "            pm.expect(result).to.equal(\"canceled\\n\");",
                  "            break;",
                  "        case \"accept\":",
                  "            pm.expect(result).to.equal(\"driver_assigned\\n\");",
                  "            break;",
                  "        case \"arrived\":",
                  "            pm.expect(result).to.equal(\"waiting_for_confirmation\\n\");",
                  "            break;",
                  "",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
